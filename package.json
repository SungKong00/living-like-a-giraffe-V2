{
  "name": "riragi-world",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/start.mjs",
    "build": "vite build",
    "start": "node server/start.mjs --production",
    "prepare:world": "node world/prepare.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:world": "node tests/world-integration.mjs",
    "test:browser": "node tests/browser.mjs",
    "bench:characters": "vite build && node tests/character-bench.mjs --from https://living-like-a-giraffe.pages.dev",
    "build:cloud": "vite build && node scripts/package-helper.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.37.1",
    "@babylonjs/loaders": "^9.37.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "express": "^5.3.0",
    "gl-matrix": "^3.4.4",
    "gltf-validator": "^2.0.0-dev.3.10",
    "lucide": "^1.78.0",
    "meshoptimizer": "^1.3.0",
    "pretendard": "^1.3.9",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.5",
    "vite": "^7.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "prettier": "^3.10.1"
  }
}
